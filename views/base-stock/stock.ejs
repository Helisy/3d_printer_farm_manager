    <style>
        .info-display
        {
            display:  flex;
            flex-direction: column;
            gap: .25rem;
            width: 12rem;
        }

        .info-display > span:nth-child(1) 
        {
            font-size: .8rem;
            font-weight: 800;
            color: var(--primary_darker);
        }

        .custom-1 
        {
            display: flex;
        }

        .custom-1 > button 
        {
            padding: .6rem 1.5rem;
            border: none;
            height: 100%;
        }

        .custom-1 > button > i 
        {
            margin-right: .5rem;
        }

        .custom-1 > button:nth-child(1)
        {
 
            border-radius: 10rem 0 0 10rem;          
            background-color: white;
            border: 1px solid var(--spacer);
            font-weight: 600;
        }

        .custom-1 > button:nth-child(2)
        {
            border-radius: 0 10rem 10rem 0;
            background-color: var(--primary);
            color: white;
            font-weight: 600;
        }

        .custom-1 > button:active
        {
            background-color: var(--primary_darker);
            color: white;
        }


        .custom-2
        {
            display: flex;
        }
        
        .custom-2 button 
        {
            width: 2.5rem;
            padding: 0 .25rem;
            border: none;
            outline: none;
            border-top: 1px solid var(--spacer);
            border-bottom: 1px solid var(--spacer);
            background-color: white;
            transition: .1s ease;
            position: relative;
        }

        .custom-2 > button:nth-child(1)
        {
            border-radius: 10rem 0 0 10rem;
            border-left: 1px solid var(--spacer);
            
        }

        .custom-2 > button:nth-child(5)
        {
            width: auto;
            padding: 0 .5rem;
            background-color: var(--primary_light);
            color: var(--primary_darker);
        }

        .custom-2 button::after
        {
            content: "";
            height: .75rem;
            width: 1px;
            background-color: var(--spacer);
            position: absolute;
            right: 0;
            top: 0;
            transform: translateY(100%);
        }

        .custom-2 > button:nth-child(4)::after, .custom-2 > button:nth-child(5):after{
            background-color: transparent;
        }   

        .custom-2 button:active
        {
            background-color: var(--primary_darker);
            color: white;
        }

        .custom-2 input 
        {
            border-top: 1px solid var(--spacer);
            border-bottom: 1px solid var(--spacer);
            border-right: 1px solid var(--spacer);
            border-left: 0;
            border-radius: 0 10rem 10rem 0;
            font-size: 1.5rem;
            width: 8rem;
            text-align: center;
            background-color: var(--background);
        }

    </style>

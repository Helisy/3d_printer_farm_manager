    async function fetchBaseStock() {

        const stock = await fetchInfo(`/api/v1/base-stock/get-all-stock?inventory_id=${inventory_id}&type=${type}`);

        if(stock.error){
            return pushNotify("error", "Não foi possível obter a informação de estoque da base!")
        }

        base_stock = stock.data;
    }

    async function updateStock(product_id, action, el_id) {
        const el = document.querySelector("#" + el_id + " input");

        const filtered = base_stock.filter(st => st.id == product_id)

        if(el.value < 1) return;

        console.log(filtered[0])
        
        let response_1 = await postData(`/api/v1/base-stock/update-stock`, "post", {
            inventory_id,
            product_id,
            action,
            value: el.value,
            stock: filtered[0].stock, 
            sku: filtered[0].sku, 
        });

        if(response_1.message.includes("Sincronia")){
            pushNotify("error", response_1.message);

            await fetchBaseStock();
            await sleep(50)
            showStock(search_inpt.value)
            return;
        }

        if(response_1.error){
            return pushNotify("error", response_1.message);
        }

        pushNotify("success", "Atualização concluída");
        await fetchBaseStock();
        await sleep(50)
        showStock(search_inpt.value)
    }
    
    async function showStock(sku) {
        const filtered = base_stock.filter(st => Number(st.sku.split("-")[1]) === Number(sku))

        let html = "";


        for (const [index, element] of filtered.entries()) {
            html += 
            `
                <div class="struct-card row align-center space-between" id="row-${index}">
                    <div class="flex gap-1p5">
                        <div class="info-display">
                            <span>SKU</span>
                            <span>${element.sku}</span>
                        </div>
                        <div class="info-display">
                            <span>Estoque Atual</span>
                            <span>${Object.values(element.stock)[1]} un.</span>
                        </div>
                    </div>
                    <div class="flex ">
                        <div class="custom-2">
                            <button onclick="add('row-${index}', 1)">+1</button>
                            <button onclick="add('row-${index}', 5)">+5</button>
                            <button onclick="add('row-${index}', 10)">+10</button>
                            <button onclick="add('row-${index}', 50)">+50</button>
                            <button onclick="clearInpt('row-${index}')">limpar</button>
                            <input type="text" value="0">
                        </div>
                        <div class="flex align-center">
                            <i class="fa-solid fa-arrow-right-long" style="font-size: 2rem; margin: 0 1rem; color: var(--primary);"></i>
                        </div>
                        <div class="custom-1">
                            <button onclick="updateStock(${element.id}, 'remove', 'row-${index}')"><i class="fa-solid fa-minus"></i>Remover</button>
                            <button onclick="updateStock(${element.id}, 'add', 'row-${index}')"><i class="fa-solid fa-plus"></i>Adicionar</button>
                        </div>
                    </div>
                </div>
            `;
        }

        stock_holder.innerHTML = html;
    } 

    function onlyNumber(e){
        e.value = e.value.replace(/[^0-9]/g, '');
    }

    function add(el_id, qtd){
        const el = document.querySelector("#" + el_id + " input");
        el.value = Number(el.value) + Number(qtd);
    }

    function clearInpt(el_id){
        const el = document.querySelector("#" + el_id + " input");
        el.value = 0;
    }

    function formatTime(time) {
        const [hours, minutes, seconds] = time.split(':').map(Number);

        const parts = [];
        if (hours > 0) parts.push(`${hours}h`);
        if (minutes > 0) parts.push(`${minutes}m`);
        if (seconds > 0) parts.push(`${seconds}s`);

        return parts.join(' ') || '0s';
    }

    function corDate(date){
        if(!date) return "";

        date = new Date(date)

        date.setHours(date.getHours() - 3, date.getMinutes(), date.getSeconds())

        date = date.toISOString();

        var newDate = date.split(".")[0]
        newDate = newDate.split("T");

        var day = newDate[0].split("-")
        return `${day[2]}/${day[1]}/${day[0]} ${newDate[1]}`;
    }

    const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

    </script>
</body>

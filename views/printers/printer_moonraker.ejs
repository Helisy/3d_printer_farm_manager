    function printerStart(file){
        if (isSocketOpen) {
            const comando = {
                method: "printer.print.start",
                jsonrpc: "2.0",
                params: {
                    filename: file
                }
            }

            // Envia o comando via WebSocket
            socket.send(JSON.stringify(comando));
            console.log('Comando enviado:', comando);
        } else {
            console.log('Aguardando conexão WebSocket...');
        }
    }

    async function printerStop(){
        if (isSocketOpen) {
            const comando = {
                method: "printer.print.cancel",
                jsonrpc: "2.0"
            };

            // Envia o comando via WebSocket
            socket.send(JSON.stringify(comando));
            
            await sleep(1000);

            await resetCurrentJob();
        } else {
            console.log('Aguardando conexão WebSocket...');
        }

        await sleep(5000);

        await resetCurrentJob();
    }
    
    function initConnection(ip) {
        socket = new WebSocket(`ws://${ip}:7125/websocket`);

        socket.addEventListener('open', function (event) {
            console.log('Conectado ao WebSocket!');
            socket.send(JSON.stringify(subscribeWS));
            isSocketOpen = true; // Marca que a conexão foi aberta
        });

        socket.addEventListener('message', function (event) {
            const update =  JSON.parse(event.data);
            if(update.method != "notify_status_update"){
                const { virtual_sdcard, print_stats } = update?.params[0];

                if(virtual_sdcard?.progress == undefined &&  print_stats?.print_duration== undefined && current_status == 2 && current_file !=null){

                    if(!printer_ip) return;

                    finishCurrentJobs();
                }
            }

            showProgress(event.data);
        });

        socket.addEventListener('close', function (event) {
            window.location.replace("/printers")
            console.log('Conexão com o WebSocket foi fechada.');
            isSocketOpen = false; // Marca que a conexão foi fechada
        });

        socket.addEventListener('error', function (event) {
            console.error('Erro no WebSocket:', event);
        });
    }

    
    
    let last_progress = 0;
    function showProgress(data) {
        const update = JSON.parse(data);

        switch (current_status) {
            case 1:
                printer_progress.innerHTML = "<h2>Esperando...</h2>"
                return;
            case 3:
                printer_progress.innerHTML = "<h2>Impressão Concluída</h2>"
                return;
        }

        if(update.method != "notify_status_update") return;

        const { virtual_sdcard, print_stats } = update.params[0];
    
        console.log((virtual_sdcard?.progress * 100).toFixed(2), print_stats?.print_duration)

        if(virtual_sdcard?.progress != undefined){
            last_progress = virtual_sdcard?.progress * 100;
        }

        if(print_stats?.print_duration == undefined){
            printer_progress.innerHTML = "<h2>Iniciando Impressão</h2>"
            return;
        }

        // printer_progress.innerHTML = `<h2>${last_progress.toFixed(2)}% - ${formatTimeSeconds(print_stats?.print_duration)}</h2>`

        const progress = (print_stats.print_duration / current_estimated_time) * 100;
        if (isNaN(progress)) return;

        printer_progress.innerHTML = `<h2>${progress <=100 ? progress.toFixed(2) : 100}% - ${formatTimeSeconds(current_estimated_time - print_stats.print_duration < 0 ? 0 : current_estimated_time - print_stats.print_duration)}</h2>`
    }

    async function togglePrinter() {
        await fetchInfo(`/api/v1/printers/${printer_id}/toggle`);
        window.location.reload();
    }

    async function resetCurrentJob() {
        await fetchInfo(`http://${printer_ip}:4408/server/files/gcodes/${current_file}`, method="delete");
        await fetchInfo(`/api/v1/printers/${printer_id}/reset_job`);
        current_status = 1;
        current_file = undefined;
        await main();
    }

    async function resetPrinterJob() {
        await fetchInfo(`/api/v1/printers/${printer_id}/reset_printer`);
        current_status = 1;
        current_file = undefined;
        printerStop();
        await main();
    }

    async function finishCurrentJobs() {
        if(printer_progress.dataset.cur_job_id == "") return;

        const printer_job_list = await fetchInfo(`http://${printer_ip}:4408/server/history/list`);

        let cur_data = await fetchInfo(`/api/v1/jobs/${printer_progress.dataset.cur_job_id}`);
        const printer_cur_job_status = printer_job_list.result.jobs.filter(e => e.filename == current_file)[0].status;

        if(cur_data.data.status_id == 2 && printer_cur_job_status == "completed"){
            console.log("FINISH FINISH FINISH FINISH FINISH FINISH FINISH FINISH FINISH FINISH FINISH FINISH FINISH")
            await fetchInfo(`/api/v1/printers/${printer_id}/job_done`);
            await main();

        }
    }

    async function concludeCurrentJobs(){
        let cur_data = await fetchInfo(`/api/v1/jobs/${printer_progress.dataset.cur_job_id}`);

        if(cur_data.data.status_id == 3){
            await fetchInfo(`http://${printer_ip}:4408/server/files/gcodes/${current_file}`, method="delete");
            current_status = 1;
            current_file = undefined;
            await fetchInfo(`/api/v1/printers/${printer_id}/job_conclude`);
            await main();
        }
    }

    
    
    function sleep(ms) {
	    return new Promise(resolve => setTimeout(resolve, ms));
    }

    function formatTimeSeconds(seconds) {
        const totalSegundos = Math.floor(seconds);

        const horas = Math.floor(totalSegundos / 3600);
        const minutos = Math.floor((totalSegundos % 3600) / 60);
        const segundos = totalSegundos % 60;

        return `${horas}h ${minutos}m ${segundos}s`;
    }

    function formatTime(time) {
        const [hours, minutes, seconds] = time.split(':').map(Number);

        const parts = [];
        if (hours > 0) parts.push(`${hours}h`);
        if (minutes > 0) parts.push(`${minutes}m`);
        if (seconds > 0) parts.push(`${seconds}s`);

        return parts.join(' ') || '0s';
    }

